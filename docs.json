{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Itaja",
  "colors": {
    "primary": "#0E5F52",
    "light": "#5FB8A3",
    "dark": "#0A4A40"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Rubik",
    "heading": {
      "family": "Bricolage Grotesque"
    }
  },
  "background": {
    "color": {
      "light": "#FAF8F3",
      "dark": "#0A1F1B"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.getitaja.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Merchant of Record",
            "icon": "landmark",
            "pages": [
              "merchant-of-record/what-is-mor",
              "merchant-of-record/how-itaja-works",
              "merchant-of-record/compliance",
              "merchant-of-record/pricing"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "compass",
        "pages": [
          "guides/index"
        ]
      },
      {
        "tab": "API Reference",
        "icon": "terminal",
        "pages": [
          "api-reference/index"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.getitaja.com",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Join the beta",
      "href": "https://www.getitaja.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/itaja"
    }
  }
}
