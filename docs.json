            "icon": "book-open",
            "groups": [
              {
                "group": "Pour commencer",
                "icon": "rocket",
                "pages": [
                  "fr/index",
                  "fr/quickstart"
                ]
              },
              {
                "group": "Merchant of Record",
                "icon": "landmark",
                "pages": [
                  "fr/merchant-of-record/what-is-mor",
                  "fr/merchant-of-record/how-itaja-works",
                  "fr/merchant-of-record/compliance",
                  "fr/merchant-of-record/pricing"
                ]
              }
            ]
          },
          {
            "tab": "Guides",
            "icon": "compass",
            "pages": [
              "fr/guides/index"
            ]
          },
          {
            "tab": "Référence API",
            "icon": "terminal",
            "pages": [
              "fr/api-reference/index"
            ]
          }
        ]
